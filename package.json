{
  "name": "@chenjie1129/dsh-reliability-governor-plugin",
  "version": "0.6.0",
  "description": "A2UI contract review, receipt-bound authorship, deterministic evidence gates, and bounded repair for DeepSeek Harness agents",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "agent-reliability",
    "llm-evaluation",
    "reliability",
    "verification",
    "agent"
  ],
  "license": "MIT",
  "author": "chenjie1129",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenjie1129/deepseek-harness-reliability-governor.git"
  },
  "homepage": "https://github.com/chenjie1129/deepseek-harness-reliability-governor#readme",
  "bugs": {
    "url": "https://github.com/chenjie1129/deepseek-harness-reliability-governor/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "evaluations",
    "examples",
    "scripts",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "FEEDBACK.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "LICENSE"
  ],
  "scripts": {
    "build:node": "tsc -p tsconfig.json",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run build:node && npm run typecheck:client && npm run build:client",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:validate": "node scripts/validate-evaluations.mjs",
    "prebenchmark:keyless": "npm run build",
    "benchmark:keyless": "node scripts/run-keyless-benchmark.mjs",
    "benchmark:keyless:check": "node scripts/run-keyless-benchmark.mjs --output ./.npm-cache/keyless-report.json",
    "benchmark:live": "node scripts/run-live-benchmark.mjs",
    "benchmark:live:plan": "node scripts/run-live-benchmark.mjs --plan",
    "demo:render": "node scripts/render-keyless-demo.mjs",
    "demo:check": "node scripts/render-keyless-demo.mjs --check",
    "release:verify": "node scripts/verify-release.mjs",
    "check": "npm run test && npm run eval:validate && npm run build && npm run benchmark:keyless:check && npm run benchmark:live:plan && npm run demo:check && npm run release:verify && npm pack --dry-run --cache ./.npm-cache",
    "prepack": "npm run build"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-user-questions"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-fs": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-sandbox": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-skill": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-user-questions": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-policy": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@a2ui/react": "0.9.1",
    "@a2ui/web_core": "0.9.2",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
